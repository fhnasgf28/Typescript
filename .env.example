MCP_TRANSFER_SERVER_NAME=server-a
MCP_TRANSFER_HOME_ALLOWLIST_PREFIX=/home/fhnasgf
MCP_TRANSFER_BASE_DIR=/home/fhnasgf/mcp-transfer
MCP_TRANSFER_MAX_FILE_MB=50
MCP_TRANSFER_WEB_ADMIN_USERNAME=admin
MCP_TRANSFER_WEB_ADMIN_PASSWORD=dev-admin-password-change-before-use
MCP_TRANSFER_SESSION_SECRET=dev-session-secret-32-bytes-minimum-123456
MCP_TRANSFER_PUBLIC_URL=https://server-a.clipperyt.online
MCP_TRANSFER_DEST_SERVER_B_TOKEN=dev-peer-token-change-before-use

# Standalone PMT MCP client identity (configure separately on every OpenClaw server)
MCP_PMT_API_URL=https://pmt.example.com
MCP_PMT_API_TOKEN=replace-with-this-agent-peer-token
MCP_PMT_AGENT_ID=openclaw-server-a

# Optional read-only Google Docs task context. Keep this owner-only file outside
# the repository. Integration stays disabled when the path is absent.
MCP_PMT_GOOGLE_DOCS_SERVICE_ACCOUNT_FILE=/home/fhnasgf/.config/pmt/google-service-account.json
MCP_PMT_GOOGLE_DOCS_TIMEOUT_SECONDS=30
# Docker overlay only: host file must be owned by UID/GID 10001 and mode 0600.
MCP_PMT_GOOGLE_DOCS_CREDENTIAL_HOST_FILE=/absolute/host/path/google-service-account.json

# Optional event-driven Bug Tracker Shadow Sync. Disabled by default. The
# service account needs Drive metadata read and Sheets read-only access. Enabling
# config does not register until an administrator explicitly clicks Register.
# Run one durable worker recovery pass about once per minute (or Docker profile worker).
MCP_PMT_DRIVE_WATCH_ENABLED=false
MCP_PMT_DRIVE_SPREADSHEET_ID=replace-with-spreadsheet-id
MCP_PMT_DRIVE_CSV_URL=https://docs.google.com/spreadsheets/d/replace-with-spreadsheet-id/export?format=csv&gid=0
# Generate independently; at least 32 bytes. Never commit the real value.
MCP_PMT_DRIVE_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Optional. When omitted, derived exactly from MCP_TRANSFER_PUBLIC_URL.
# MCP_PMT_DRIVE_WEBHOOK_CALLBACK_URL=https://pmt.example.com/api/v1/pmt/drive-notifications/bug-tracker
MCP_PMT_DRIVE_ASSIGNEE=Farhan
MCP_PMT_DRIVE_DEV_STATUS=To-Do
MCP_PMT_DRIVE_PROJECT=HMX
MCP_PMT_DRIVE_TARGET_BRANCH=Human-Resources

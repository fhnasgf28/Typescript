[Unit]
Description=Create and verify Standalone PMT SQLite backup
After=standalone-pmt.service

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/projects/mcp-transfer-node
EnvironmentFile=%h/.config/standalone-pmt/pmt.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.openclaw/workspace/projects/mcp-transfer-node/.venv/bin/mcp-pmt-backup --retention 14
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/standalone-pmt -%h/mcp-transfer
